[gd_resource type="Resource" script_class="CombatV1Skill" load_steps=14 format=3]

[ext_resource type="Script" path="res://combat_v1/skill.gd" id="1_skill"]
[ext_resource type="Script" path="res://combat_v1/skill_event.gd" id="2_event"]
[ext_resource type="Script" path="res://combat_v1/skill_effect.gd" id="3_effect_base"]
[ext_resource type="Script" path="res://combat_v1/performance_result_skill_effect.gd" id="4_result"]
[ext_resource type="Script" path="res://combat_v1/composure_recovery_skill_effect.gd" id="5_recovery"]

[sub_resource type="Resource" id="SkillEvent_2"]
script = ExtResource("2_event")
beat_offset = 2.0
actions = Array[StringName]([&"left", &"right"])

[sub_resource type="Resource" id="SkillEvent_3_5"]
script = ExtResource("2_event")
beat_offset = 3.5
actions = Array[StringName]([&"up", &"down"])

[sub_resource type="Resource" id="SkillEvent_5"]
script = ExtResource("2_event")
beat_offset = 5.0
actions = Array[StringName]([&"left", &"right"])

[sub_resource type="Resource" id="SkillEvent_6_5"]
script = ExtResource("2_event")
beat_offset = 6.5
actions = Array[StringName]([&"up", &"down"])

[sub_resource type="Resource" id="SkillEvent_8"]
script = ExtResource("2_event")
beat_offset = 8.0
actions = Array[StringName]([&"left", &"right"])

[sub_resource type="Resource" id="SkillEvent_9_5"]
script = ExtResource("2_event")
beat_offset = 9.5
actions = Array[StringName]([&"up", &"down"])

[sub_resource type="Resource" id="SkillEvent_11"]
script = ExtResource("2_event")
beat_offset = 11.0
actions = Array[StringName]([&"up", &"right", &"down", &"left"])

[sub_resource type="Resource" id="PerformanceResultEffect"]
script = ExtResource("4_result")
tactical_effectiveness = 1

[sub_resource type="Resource" id="ComposureRecoveryEffect"]
script = ExtResource("5_recovery")
amount = 20.0

[resource]
script = ExtResource("1_skill")
skill_id = &"steadying_harmony"
display_name = "Steadying Harmony"
musical_contribution = &"Harmony"
interaction_summary = "Measured chord pulses ending in a four-note chord."
effect_summary = "Restore 20 Composure on a correct performance; no direct Groove."
inspiration_cost = 30.0
bar_count = 3
events = Array[ExtResource("2_event")]([SubResource("SkillEvent_2"), SubResource("SkillEvent_3_5"), SubResource("SkillEvent_5"), SubResource("SkillEvent_6_5"), SubResource("SkillEvent_8"), SubResource("SkillEvent_9_5"), SubResource("SkillEvent_11")])
effects = Array[ExtResource("3_effect_base")]([SubResource("PerformanceResultEffect"), SubResource("ComposureRecoveryEffect")])
