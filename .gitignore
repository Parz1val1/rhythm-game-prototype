# Godot 4+ specific ignores
.godot/
.freebuff/
/android/
/builds/
.claude/worktrees/

# Auto-generated Godot UID sidecar files (regenerated on project open)
*.uid

# Wwise authoring/integration files regenerated per developer machine.
*.wsettings
*.validationcache
**/.cache/
/Wwise/resources/WwiseProjectData.tres

# Godot hot-reload replacement files for loaded native libraries/resources.
*~RF*.TMP

# Godot mistakes raw spike CSV evidence for translation source during editor scans.
/spikes/wwise/evidence/**/*.translation
/spikes/wwise/evidence/**/*.csv.import
